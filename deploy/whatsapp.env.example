# Variables para el despliegue de NextTech Custom.
# Copiar estos valores al .env/secret manager que usa Infraestructura.
# La API Key real NO debe versionarse ni enviarse por canales públicos.

WHATSAPP_ENABLED=true
WHATSAPP_API_BASE_URL=https://api-whatsapp.34-174-37-7.sslip.io
WHATSAPP_API_KEY=REEMPLAZAR_CON_API_KEY_FINAL_DE_LA_VM_WHATSAPP
WHATSAPP_API_KEY_HEADER=X-API-Key
WHATSAPP_API_TIMEOUT_SECONDS=30

# Si la API .NET se ejecuta directamente sin deploy/docker-compose.yml,
# usar las claves nativas de ASP.NET Core equivalentes:
# WhatsApp__Enabled=true
# WhatsApp__BaseUrl=https://api-whatsapp.34-174-37-7.sslip.io
# WhatsApp__ApiKey=REEMPLAZAR_CON_API_KEY_FINAL_DE_LA_VM_WHATSAPP
# WhatsApp__ApiKeyHeader=X-API-Key
# WhatsApp__TimeoutSeconds=30
