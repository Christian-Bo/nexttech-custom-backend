{
  "info": {
    "name": "NextTech Tienda - flujo efectivo",
    "description": "Usa el Auth de develop: POST /api/auth y POST /api/internal/auth. No hay /api/dev/token.\n\nComprador: registrar una vez en Oracle y luego login.\nSupervisor/repartidor: ejecutar database/sqlserver/seed/dev_usuarios_internos.sql en la SQL remota (supervisor@nexttech.com y repartidor@nexttech.com; misma clave que el ADMIN del script oficial). El ADMIN oficial nace con debeCambiarPassword=true; InternalOnly lo bloquea hasta POST /api/internal/auth/change-password.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "buyerIdentifier", "value": "tienda.dev@example.com" },
    { "key": "buyerPassword", "value": "TiendaDev1" },
    { "key": "supervisorEmail", "value": "supervisor@nexttech.com" },
    { "key": "supervisorPassword", "value": "admin123" },
    { "key": "repartidorEmail", "value": "repartidor@nexttech.com" },
    { "key": "repartidorPassword", "value": "admin123" },
    { "key": "tokenComprador", "value": "" },
    { "key": "tokenSupervisor", "value": "" },
    { "key": "tokenRepartidor", "value": "" },
    { "key": "codigoOrden", "value": "" },
    { "key": "idVariante", "value": "1" },
    { "key": "idZonaA", "value": "1" },
    { "key": "idZonaB", "value": "2" },
    { "key": "idPersonalizacion", "value": "" },
    { "key": "idAreaEntrega", "value": "1" },
    { "key": "idArchivoImagen", "value": "" },
    { "key": "idArchivoConstancia", "value": "" }
  ],
  "item": [
    {
      "name": "0. Auth (compañero)",
      "item": [
        {
          "name": "0a. Registrar comprador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.token && json.token.accessToken) {",
                  "    pm.collectionVariables.set('tokenComprador', json.token.accessToken);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{buyerIdentifier}}\",\n  \"phone\": \"55551234\",\n  \"nickname\": \"tiendadev\",\n  \"password\": \"{{buyerPassword}}\",\n  \"birthDate\": \"2002-05-10\",\n  \"notifyByEmail\": true,\n  \"notifyByWhatsApp\": false\n}"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Crea el comprador en Oracle. Si ya existe, usa 0b (login). Contraseña: mayúscula, minúscula y número, mínimo 8."
          }
        },
        {
          "name": "0b. Login comprador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('tokenComprador', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{buyerIdentifier}}\",\n  \"password\": \"{{buyerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "0c. Login supervisor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('tokenSupervisor', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{supervisorEmail}}\",\n  \"password\": \"{{supervisorPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/internal/auth/login"
          }
        },
        {
          "name": "0d. Login repartidor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('tokenRepartidor', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{repartidorEmail}}\",\n  \"password\": \"{{repartidorPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/internal/auth/login"
          }
        }
      ]
    },
    {
      "name": "1. Catalogo",
      "item": [
        {
          "name": "1a. Productos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/catalog/products"
          }
        },
        {
          "name": "1b. Detalle LLV-001",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const p = pm.response.json();",
                  "  if (p.variantes && p.variantes.length) {",
                  "    pm.collectionVariables.set('idVariante', String(p.variantes[0].idVariante));",
                  "  }",
                  "  if (p.zonas && p.zonas.length >= 2) {",
                  "    pm.collectionVariables.set('idZonaA', String(p.zonas[0].idZona));",
                  "    pm.collectionVariables.set('idZonaB', String(p.zonas[1].idZona));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/catalog/products/LLV-001"
          }
        },
        {
          "name": "1c. Areas de entrega",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const areas = pm.response.json();",
                  "  if (Array.isArray(areas) && areas.length) {",
                  "    pm.collectionVariables.set('idAreaEntrega', String(areas[0].idAreaEntrega));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/catalog/delivery-areas"
          }
        }
      ]
    },
    {
      "name": "2. Comprador",
      "item": [
        {
          "name": "2a. Crear personalizacion",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('idPersonalizacion', String(pm.response.json().idPersonalizacion));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenComprador}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idVariante\": {{idVariante}},\n  \"zonas\": [\n    {\n      \"idZona\": {{idZonaA}},\n      \"configuracionJson\": \"{\\\"texto\\\":\\\"Lado A\\\"}\",\n      \"imagenBase64\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==\",\n      \"nombreArchivo\": \"lado-a.png\",\n      \"tipoMime\": \"image/png\"\n    },\n    {\n      \"idZona\": {{idZonaB}},\n      \"configuracionJson\": \"{\\\"texto\\\":\\\"Lado B\\\"}\",\n      \"imagenBase64\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==\",\n      \"nombreArchivo\": \"lado-b.png\",\n      \"tipoMime\": \"image/png\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/personalizations"
          }
        },
        {
          "name": "2a2. Ver personalizacion",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenComprador}}" }
            ],
            "url": "{{baseUrl}}/api/personalizations/{{idPersonalizacion}}"
          }
        },
        {
          "name": "2b. Agregar al carrito",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenComprador}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idVariante\": {{idVariante}},\n  \"cantidad\": 1,\n  \"idPersonalizacion\": {{idPersonalizacion}}\n}"
            },
            "url": "{{baseUrl}}/api/cart/items"
          }
        },
        {
          "name": "2c. Ver carrito",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenComprador}}" }
            ],
            "url": "{{baseUrl}}/api/cart"
          }
        },
        {
          "name": "2d. Checkout efectivo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('codigoOrden', json.codigoOrden);",
                  "  if (json.idArchivoConstancia) {",
                  "    pm.collectionVariables.set('idArchivoConstancia', json.idArchivoConstancia);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenComprador}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idAreaEntrega\": {{idAreaEntrega}},\n  \"referenciaEntrega\": \"Edificio 2, entrada principal\",\n  \"metodoPago\": \"EFECTIVO\"\n}"
            },
            "url": "{{baseUrl}}/api/checkout"
          }
        },
        {
          "name": "2e. Tracking",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenComprador}}" }
            ],
            "url": "{{baseUrl}}/api/orders/{{codigoOrden}}/tracking"
          }
        },
        {
          "name": "2e2. Constancia PDF",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenComprador}}" }
            ],
            "url": "{{baseUrl}}/api/orders/{{codigoOrden}}/receipt",
            "description": "Descarga la constancia PDF con QR. El PDF también se adjunta al correo de confirmación."
          }
        },
        {
          "name": "2e3. QR en pantalla",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenComprador}}" }
            ],
            "url": "{{baseUrl}}/api/orders/{{codigoOrden}}/receipt-qr",
            "description": "PNG del mismo QR del PDF. El portal lo muestra grande para que el repartidor escanee sin abrir el archivo. Payload = codigoOrden."
          }
        },
        {
          "name": "2f. Mis compras",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenComprador}}" }
            ],
            "url": "{{baseUrl}}/api/orders/my"
          }
        }
      ]
    },
    {
      "name": "3. Supervisor",
      "item": [
        {
          "name": "3a. Cola en elaboracion",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenSupervisor}}" }
            ],
            "url": "{{baseUrl}}/api/supervisor/orders/in-production"
          }
        },
        {
          "name": "3a2. Detalle para impresion",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const zona = json.items && json.items[0] && json.items[0].zonas && json.items[0].zonas[0];",
                  "  if (zona) {",
                  "    pm.collectionVariables.set('idArchivoImagen', zona.idArchivoImagenFinal);",
                  "  }",
                  "  if (json.idArchivoConstancia) {",
                  "    pm.collectionVariables.set('idArchivoConstancia', json.idArchivoConstancia);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenSupervisor}}" }
            ],
            "url": "{{baseUrl}}/api/supervisor/orders/{{codigoOrden}}",
            "description": "Devuelve variante, atributos y archivos Lado A/B para imprimir."
          }
        },
        {
          "name": "3a3. Descargar archivo de zona",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenSupervisor}}" }
            ],
            "url": "{{baseUrl}}/api/supervisor/orders/{{codigoOrden}}/files/{{idArchivoImagen}}"
          }
        },
        {
          "name": "3b. Marcar listo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenSupervisor}}" }
            ],
            "url": "{{baseUrl}}/api/supervisor/orders/{{codigoOrden}}/ready"
          }
        },
        {
          "name": "3c. Cola listo para entrega",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenSupervisor}}" }
            ],
            "url": "{{baseUrl}}/api/supervisor/orders/ready"
          }
        },
        {
          "name": "3d. Dashboard ventas",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenSupervisor}}" }
            ],
            "url": "{{baseUrl}}/api/dashboard/sales?range=week"
          }
        }
      ]
    },
    {
      "name": "4. Repartidor",
      "item": [
        {
          "name": "4a. Disponibles",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenRepartidor}}" }
            ],
            "url": "{{baseUrl}}/api/delivery/available"
          }
        },
        {
          "name": "4a2. Buscar orden (teclado/QR)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenRepartidor}}" }
            ],
            "url": "{{baseUrl}}/api/delivery/orders/{{codigoOrden}}"
          }
        },
        {
          "name": "4b. Tomar orden",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenRepartidor}}" }
            ],
            "url": "{{baseUrl}}/api/delivery/{{codigoOrden}}/take"
          }
        },
        {
          "name": "4c. Completar entrega",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenRepartidor}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fotoBase64\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==\",\n  \"nombreArchivo\": \"entrega.png\",\n  \"tipoMime\": \"image/png\"\n}"
            },
            "url": "{{baseUrl}}/api/delivery/{{codigoOrden}}/complete"
          }
        },
        {
          "name": "4d. Pago no realizado",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenRepartidor}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"observacion\": \"El comprador no tenia efectivo\"\n}"
            },
            "url": "{{baseUrl}}/api/delivery/{{codigoOrden}}/payment-failed",
            "description": "Cierra el intento con PAGO_NO_REALIZADO y libera la orden a listo para entrega. No usar en el mismo pedido que 4c."
          }
        },
        {
          "name": "4e. Comprador no encontrado",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenRepartidor}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"observacion\": \"No se encontro al comprador en el area\"\n}"
            },
            "url": "{{baseUrl}}/api/delivery/{{codigoOrden}}/not-found",
            "description": "Cierra el intento y libera la orden a listo para entrega. No usar en el mismo pedido que 4c."
          }
        }
      ]
    }
  ]
}
