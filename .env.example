# NextTech Custom - ejemplo de configuración local.
# Copiar como .env y completar localmente. NUNCA subir .env al repositorio.

ASPNETCORE_ENVIRONMENT=Development

# SQL Server de la tienda (servidor compartido/remoto)
# No subir host/usuario/password reales si Infraestructura los considera sensibles.
ConnectionStrings__SqlServer="Server=SQLSERVER_HOST,SQLSERVER_PORT;Database=NextTechCustomDB;User Id=SQLSERVER_USER;Password=REEMPLAZAR_LOCALMENTE;Encrypt=True;TrustServerCertificate=True"

# Oracle central
ORACLE_USER=TIENDA_APP
ORACLE_PASSWORD=REEMPLAZAR_LOCALMENTE
ORACLE_DATA_SOURCE=www.server.daossystem.pro:5626/XEPDB1

# JWT
JWT_ISSUER=NextTech.Api
JWT_AUDIENCE=NextTech.Client
JWT_EXPIRATION_MINUTES=120
JWT_SECRET=REEMPLAZAR_CON_SECRETO_DE_32_O_MAS_CARACTERES

# CORS
FRONTEND_ORIGIN_0=http://localhost:3000

# SMTP
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=nexttechsolution933@gmail.com
SMTP_PASSWORD=REEMPLAZAR_CON_APP_PASSWORD_DE_GOOGLE
SMTP_FROM=nexttechsolution933@gmail.com
SMTP_ENABLE_SSL=true
SMTP_TIMEOUT_SECONDS=20
SMTP_RECOVERY_URL_BASE=http://localhost:3000/reset-password

# NextTech Face API
FACE_API_BASE_URL=https://34.174.37.7
FACE_API_ENROLL_PATH=/api/v1/faces/enroll
FACE_API_SEGMENT_PATH=/api/v1/faces/segment/image
FACE_API_LIVENESS_PATH=/api/v1/faces/liveness/challenge
FACE_API_VERIFY_PATH=/api/v1/faces/verify-template-live
FACE_API_KEY=
FACE_API_KEY_HEADER=X-Internal-Api-Key
FACE_API_TIMEOUT_SECONDS=30
